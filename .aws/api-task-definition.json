{
  "family": "programble-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::440373532734:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "440373532734.dkr.ecr.us-east-1.amazonaws.com/programble-api:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "PROGRAMBLE_API_BASE_PATH",
          "value": "/api/v1"
        },
        {
          "name": "PROGRAMBLE_ENV",
          "value": "staging"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "staging"
        },
        {
          "name": "PROGRAMBLE_DB_URL",
          "value": "jdbc:postgresql://programble-staging-postgres.ce5gw80qs7nd.us-east-1.rds.amazonaws.com:5432/postgres"
        }
      ],
      "secrets": [
        {
          "name": "PROGRAMBLE_DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:440373532734:secret:rds!db-41cee064-24f3-4b86-afd7-c0e86f457ccd-pbNkQw:username::"
        },
        {
          "name": "PROGRAMBLE_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:440373532734:secret:rds!db-41cee064-24f3-4b86-afd7-c0e86f457ccd-pbNkQw:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/programble-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --quiet --tries=1 --spider http://127.0.0.1:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
